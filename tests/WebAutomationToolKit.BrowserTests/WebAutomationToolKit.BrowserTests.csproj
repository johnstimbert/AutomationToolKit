<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      Set this to the path of your local chromedriver/geckodriver binaries
      if you are not using Selenium Manager (the default).
      Leave empty to let Selenium Manager resolve drivers automatically.
    -->
    <WebAutomationDriverPath Condition="'$(WebAutomationDriverPath)' == ''" />
  </PropertyGroup>

  <ItemGroup>
    <!-- NuGet package from GitHub Packages (see nuget.config at repo root) -->
    <PackageReference Include="WebAutomationToolKit" Version="1.145.0" />

    <!-- Test framework -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <PackageReference Include="MSTest.TestAdapter"     Version="3.11.1" />
    <PackageReference Include="MSTest.TestFramework"   Version="3.11.1" />
    <PackageReference Include="coverlet.collector"     Version="8.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
