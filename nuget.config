<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      GitHub Packages feed for WebAutomationToolKit.
      Authenticate by setting the environment variables before restoring:
        GITHUB_ACTOR  – your GitHub username
        GITHUB_TOKEN  – a Personal Access Token with 'read:packages' scope
      e.g.:
        $env:GITHUB_ACTOR = "your-username"
        $env:GITHUB_TOKEN = "ghp_..."
        dotnet restore
    -->
    <add key="github-johnstimbert"
         value="https://nuget.pkg.github.com/johnstimbert/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github-johnstimbert>
      <add key="Username" value="%GITHUB_ACTOR%" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github-johnstimbert>
  </packageSourceCredentials>
</configuration>
